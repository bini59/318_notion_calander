# Notion public integration credentials (https://www.notion.so/my-integrations)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# 토큰 암호화 키 — 배포마다 생성: openssl rand -hex 32
TOKEN_ENC_KEY=

# 피드 URL / OAuth redirect 구성용 공개 주소
BASE_URL=http://localhost:3000

# 321_auth(SSO) — auth.bini59.dev 어드민 > 서비스에서 등록한 값.
# BASE_URL의 origin이 서비스의 허용 origin과 정확히 같아야 로그인 후 돌아올 수 있다. 로컬 SSO는 *.local.bini59.dev 필요.
AUTH_ORIGIN=https://auth.bini59.dev
CLIENT_ID=n2c
APP_SECRET=

# SQLite 파일 경로
DATABASE_URL=./data/app.db
